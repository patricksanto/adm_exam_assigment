// ─────────────────────────────────────────────────────────────
// ADM 2026 — F1 Competitiveness Analysis
// design.dbml — planned before SQL implementation
// ─────────────────────────────────────────────────────────────

// ─── PHASE 2: INTERMEDIATE MODEL ─────────────────────────────
// One row = one lap driven by one driver in one race
// No aggregation. Every row still represents one lap event.

Table int_race_laps {
  race_date             date      [note: "derived from filename"]
  circuit               varchar   [note: "derived from filename"]
  season                int       [note: "derived from filename"]
  driver_number         varchar
  driver_abbreviation   varchar
  driver_full_name      varchar
  team_name             varchar   [note: "display name, may vary across seasons"]
  team_id               varchar   [note: "stable key e.g. mercedes, sauber"]
  lap_number            int
  lap_time_seconds      float     [note: "converted from timedelta string in staging"]
  tyre_compound         varchar
  tyre_life             int
  finish_position       int       [note: "NULL for non-finishers"]
  classified_position   varchar   [note: "1-20 or R"]
  race_status           varchar   [note: "Finished / +1 Lap / Engine / etc."]
  is_finished           boolean   [note: "true only when race_status = Finished"]
  is_wet_race           varchar   [note: "wet or dry — derived from weather Rainfall"]
  avg_track_temp_c      float     [note: "average track temp across all weather samples for this race"]
  track_temp_category   varchar   [note: "cool (<30C) / warm (30-44C) / hot (>=45C)"]
}

// ─────────────────────────────────────────────────────────────
// PHASE 3: STAR MODEL
// Designed before SQL implementation
// ─────────────────────────────────────────────────────────────

// ─── DIMENSIONS ──────────────────────────────────────────────

Table dim_driver {
  driver_key          int     [pk]
  driver_number       varchar
  driver_abbreviation varchar
  driver_full_name    varchar
  team_name           varchar [note: "display name, may vary across seasons"]
  team_id             varchar [note: "stable key e.g. mercedes, sauber"]
}

Table dim_circuit {
  circuit_key int     [pk]
  circuit     varchar
  country     varchar
  location    varchar
}

Table dim_race {
  race_key            int     [pk]
  race_date           date
  circuit             varchar
  season              int
  is_wet_race         varchar
  track_temp_category varchar
}

Table dim_condition {
  condition_key       int     [pk]
  is_wet_race         varchar
  track_temp_category varchar
  condition_label     varchar [note: "e.g. wet / cool"]
}

// ─── FACT TABLES ─────────────────────────────────────────────

// Q1 — primary grain: one driver in one race
Table fct_driver_pace_gap {
  race_key              int   [ref: > dim_race.race_key]
  driver_key            int   [ref: > dim_driver.driver_key]
  avg_lap_time_s        float [note: "avg lap time of this driver, finished laps only"]
  winner_avg_lap_time_s float [note: "avg lap time of the race winner"]
  lap_time_gap_s        float [note: "driver avg minus winner avg — 0 for the winner"]
  lap_count             int   [note: "number of laps used in this driver avg"]
}

// Q1 — roll-up grain: one driver at one circuit in one season
Table fct_driver_pace_gap_by_season {
  driver_key         int   [ref: > dim_driver.driver_key]
  circuit_key        int   [ref: > dim_circuit.circuit_key]
  season             int
  avg_lap_time_gap_s float [note: "average of per-race gaps across the season at this circuit"]
  min_gap_s          float [note: "best race gap in this season at this circuit"]
  max_gap_s          float [note: "worst race gap in this season at this circuit"]
  race_count         int   [note: "number of races in this aggregation"]
}

// Q2 — primary grain: one driver in one race, grouped by condition
Table fct_pace_gap_by_condition {
  race_key              int   [ref: > dim_race.race_key]
  driver_key            int   [ref: > dim_driver.driver_key]
  condition_key         int   [ref: > dim_condition.condition_key]
  avg_lap_time_s        float
  winner_avg_lap_time_s float
  lap_time_gap_s        float
  lap_count             int
}

// Q2 — roll-up grain: one driver in one condition group in one season
Table fct_pace_gap_by_condition_season {
  driver_key         int   [ref: > dim_driver.driver_key]
  condition_key      int   [ref: > dim_condition.condition_key]
  season             int
  avg_lap_time_gap_s float
  race_count         int
}
